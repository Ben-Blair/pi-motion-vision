# Copy to etc/supabase.env and fill in (gitignored).
#
#   source etc/supabase.env
#   python scripts/upload_video_to_supabase.py

export SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
export SUPABASE_SERVICE_ROLE_KEY=
export SUPABASE_BUCKET=your-bucket-name

# Optional: max output size in MB for re-encode (default 48). Example: 49
# export UPLOAD_TARGET_MB=48

# upload_video_to_supabase.py default file (else motion-videos/input.mp4 under repo)
# export UPLOAD_VIDEO=/path/to/one_clip.mp4

# upload_new_motion_videos.py --watch: directory Motion writes MP4s into
# export MOTION_VIDEO_DIR=/path/to/motion/target_dir

# upload_new_motion_videos.py --watch: remembers uploaded basenames
# export MOTION_UPLOAD_STATE=/var/lib/motion/supabase_uploaded.log
