# OpenWeatherMap credentials for weather-based fart announcements.
#
# On the Pi, install real values (this file is safe to commit; do not put secrets here):
#   sudo cp /path/to/pi-motion-vision/etc/fart-detector.env.example /etc/fart-detector.env
#   sudo nano /etc/fart-detector.env
#   sudo chmod 600 /etc/fart-detector.env
#
# fart_detector.py reads only /etc/fart-detector.env at runtime.
OPENWEATHER_API_KEY=your_key_here
OPENWEATHER_LAT=your_latitude
OPENWEATHER_LON=your_longitude
