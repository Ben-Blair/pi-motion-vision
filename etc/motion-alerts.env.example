# Recipient address for motion, self-test, and bed-state alert emails.
#
# Install on the Pi (this file is read by the alert scripts at runtime):
#   sudo cp etc/motion-alerts.env.example /etc/motion-alerts.env
#   sudo nano /etc/motion-alerts.env
#   sudo chmod 644 /etc/motion-alerts.env
#
# Must stay world-readable: the alert scripts run as the unprivileged
# "motion" user, not as root.
#
# Outgoing mail itself is configured separately in ~/.msmtprc (see README).
TO_EMAIL=alerts@example.com
